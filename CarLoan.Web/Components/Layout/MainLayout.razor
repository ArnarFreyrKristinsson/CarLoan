@inherits LayoutComponentBase

<a class="skip-link" href="#main">Fara beint í reiknivélina</a>

<header class="site-header">
    <div class="site-header-inner">
        <span class="brand">Bílalán</span>
        <span class="brand-note">Reiknivél fyrir bílalán hjá Lykli</span>
    </div>
</header>

<main id="main" class="site-main">
    @Body
</main>

<footer class="site-footer">
    <p>
        Útreikningurinn byggir á birtum lánareglum og verðskrá Lykils. Hann er til viðmiðunar og er
        ekki lánsloforð.
    </p>
</footer>

<div id="blazor-error-ui" role="alert">
    Óvænt villa kom upp.
    <a href="" class="reload">Hlaða síðunni aftur</a>
    <button type="button" class="dismiss" aria-label="Loka">×</button>
</div>
